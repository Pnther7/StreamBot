# General media-library options
VIDEOS_DIR = "./videos"
PREVIEW_CACHE_DIR = "./tmp/preview-cache"

# yt-dlp options
YTDLP_COOKIES_PATH = ""

# Stream output settings (used by the existing media pipeline)
STREAM_RESPECT_VIDEO_PARAMS = "false"
STREAM_BITRATE_OVERRIDE = "false"
STREAM_WIDTH = "1280"
STREAM_HEIGHT = "720"
STREAM_MAX_WIDTH = "0"
STREAM_MAX_HEIGHT = "0"
STREAM_FPS = "30"
STREAM_BITRATE_KBPS = "2000"
STREAM_MAX_BITRATE_KBPS = "2500"
STREAM_HARDWARE_ACCELERATION = "false"
STREAM_VIDEO_CODEC = "H264"
STREAM_H26X_PRESET = "ultrafast"

# Web interface settings
SERVER_ENABLED = "false"
SERVER_USERNAME = "admin"
SERVER_PASSWORD = "CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD"
SERVER_PORT = "8080"
# Generate a long random value. Required when starting the web interface.
SESSION_SECRET = "REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Discord transport configuration is intentionally not documented here.
# The existing Discord integration is unofficial and is not supported for deployment.
